{
  "name": "lovebox-blog-ops",
  "version": "1.0.0",
  "description": "Lovebox — pipeline d'audit SEO multi-sites + suppression automatique des articles de blog morts, analyse par agents Claude, rapports Slack complets",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "node src/index.js audit",
    "audit:dry": "node src/index.js audit --dry-run",
    "purge": "node src/index.js purge",
    "purge:confirm": "node src/index.js purge --confirm",
    "weekly": "node src/index.js weekly-report",
    "doctor": "node src/index.js doctor",
    "auth-google": "node scripts/auth-google.js",
    "auth-shopify": "node scripts/shopify-get-token.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.7.0"
  }
}
