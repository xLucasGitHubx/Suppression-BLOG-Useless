# ============================================================
# LOVEBOX BLOG OPS — credentials
# Copie ce fichier en `.env` et remplis les valeurs.
# Rien ne tourne tant que `npm run doctor` n'est pas vert.
# ============================================================

# ---------- Anthropic (agents d'analyse Claude) ----------
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Google OAuth2 (GA4 + Search Console) ----------
# 1. Va sur console.cloud.google.com → APIs & Services → Credentials
# 2. "Create credentials" → "OAuth client ID" → Application type: "Web application"
# 3. Ajoute dans "Authorized redirect URIs" : http://localhost:3000/oauth2callback
# 4. Copie Client ID et Client Secret ci-dessous
# 5. Lance UNE FOIS : npm run auth-google  (ouvre le navigateur, sauvegarde le token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Property ID GA4 (le numéro, ex: 123456789)
GA4_PROPERTY_ID=

# ---------- Shopify Admin API (suppression articles + redirects) ----------
# Une app custom par boutique (Dev Dashboard Partners) avec scopes: read_content, write_content
# Ajoute http://localhost:3001/callback dans les Redirect URLs de chaque app.
# Lance UNE FOIS : npm run auth-shopify  (génère les 3 tokens en séquence)
SHOPIFY_STORE_EU_DOMAIN=xxx.myshopify.com
SHOPIFY_CLIENT_ID_EU=
SHOPIFY_CLIENT_SECRET_EU=
SHOPIFY_STORE_EU_TOKEN=shpat_...

SHOPIFY_STORE_FR_DOMAIN=xxx.myshopify.com
SHOPIFY_CLIENT_ID_FR=
SHOPIFY_CLIENT_SECRET_FR=
SHOPIFY_STORE_FR_TOKEN=shpat_...

SHOPIFY_STORE_EN_DOMAIN=xxx.myshopify.com
SHOPIFY_CLIENT_ID_EN=
SHOPIFY_CLIENT_SECRET_EN=
SHOPIFY_STORE_EN_TOKEN=shpat_...

# ---------- Slack ----------
# Bot token (xoxb-...) avec scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-...
# Channel ID (ex: C0123456789) — clic droit sur le channel > copier l'ID
SLACK_CHANNEL_ID=

# ---------- Comportement ----------
# true = aucune suppression réelle, tout est simulé (recommandé au début)
DRY_RUN=true
# Nombre max de suppressions par exécution (garde-fou)
MAX_DELETIONS_PER_RUN=15
